<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalkulator Zakat Profesi & Mal - Luxury Gold Edition</title>
  <style>
    :root {
      --bg-dark: #0a0a0c;
      --card-bg: rgba(20, 20, 26, 0.85);
      --gold-primary: #ffd700;
      --gold-light: #ffe87c;
      --gold-dark: #b8860b;
      --gold-gradient: linear-gradient(135deg, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);
      --gold-glow: 0 0 15px rgba(212, 175, 55, 0.4);
      --text-main: #f0f0f0;
      --text-muted: #a0a0ab;
      --border-gold: rgba(212, 175, 55, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(184, 134, 11, 0.15), transparent 70%),
        radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.08), transparent 50%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 800px;
      background: var(--card-bg);
      border: 1px solid var(--border-gold);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), var(--gold-glow);
      backdrop-filter: blur(10px);
    }

    /* Header Styling */
    .header {
      text-align: center;
      margin-bottom: 30px;
      border-bottom: 1px solid var(--border-gold);
      padding-bottom: 20px;
    }

    .title {
      font-size: 2rem;
      font-weight: 700;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
    }

    .developer-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(212, 175, 55, 0.1);
      border: 1px solid var(--border-gold);
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.85rem;
      color: var(--gold-light);
      letter-spacing: 0.5px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background-color: #00ff88;
      border-radius: 50%;
      box-shadow: 0 0 8px #00ff88;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.7);
      }
      70% {
        transform: scale(1.2);
        box-shadow: 0 0 0 8px rgba(0, 255, 136, 0);
      }
      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(0, 255, 136, 0);
      }
    }

    /* Tabs Navigation */
    .tab-container {
      display: flex;
      gap: 10px;
      margin-bottom: 25px;
      background: rgba(0, 0, 0, 0.4);
      padding: 5px;
      border-radius: 12px;
      border: 1px solid rgba(212, 175, 55, 0.15);
    }

    .tab-btn {
      flex: 1;
      padding: 12px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    .tab-btn.active {
      background: var(--gold-gradient);
      color: #000;
      box-shadow: var(--gold-glow);
    }

    /* Form Section */
    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.9rem;
      color: var(--gold-light);
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .currency-prefix {
      position: absolute;
      left: 15px;
      color: var(--gold-dark);
      font-weight: bold;
    }

    input[type="text"] {
      width: 100%;
      padding: 12px 15px 12px 45px;
      background: rgba(10, 10, 12, 0.8);
      border: 1px solid var(--border-gold);
      border-radius: 10px;
      color: #fff;
      font-size: 1rem;
      outline: none;
      transition: all 0.3s ease;
    }

    input[type="text"]:focus {
      border-color: var(--gold-primary);
      box-shadow: var(--gold-glow);
    }

    /* Tab Content Display */
    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Info Box */
    .info-box {
      background: rgba(212, 175, 55, 0.05);
      border-left: 3px solid var(--gold-primary);
      padding: 12px 15px;
      border-radius: 6px;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.4;
    }

    /* Result Card */
    .result-card {
      margin-top: 25px;
      background: linear-gradient(145deg, rgba(25, 25, 32, 0.9), rgba(15, 15, 20, 0.9));
      border: 1px solid var(--border-gold);
      border-radius: 15px;
      padding: 20px;
      text-align: center;
    }

    .result-title {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .result-value {
      font-size: 1.8rem;
      font-weight: 700;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .status-wajib {
      background: rgba(0, 255, 136, 0.15);
      color: #00ff88;
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .status-belum {
      background: rgba(255, 77, 77, 0.15);
      color: #ff4d4d;
      border: 1px solid rgba(255, 77, 77, 0.3);
    }

    /* Responsive Design */
    @media (max-width: 600px) {
      .container {
        padding: 20px;
      }
      .title {
        font-size: 1.4rem;
      }
      .tab-btn {
        font-size: 0.8rem;
        padding: 10px 5px;
      }
      .result-value {
        font-size: 1.4rem;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Header Section -->
    <header class="header">
      <h1 class="title">Kalkulator Zakat Syariah</h1>
      <div class="developer-badge">
        <span class="status-dot"></span>
        <span>developer : fatur62</span>
      </div>
    </header>

    <!-- Tabs Navigation -->
    <div class="tab-container">
      <button class="tab-btn active" onclick="switchTab('kontemporer')">Ulama Kontemporer (MUI)</button>
      <button class="tab-btn" onclick="switchTab('klasik')">Fikih Klasik (4 Madzhab)</button>
    </div>

    <!-- General Input: Harga Emas -->
    <div class="form-group">
      <label for="hargaEmas">Harga Emas Murni Saat Ini (per gram):</label>
      <div class="input-wrapper">
        <span class="currency-prefix">Rp</span>
        <input type="text" id="hargaEmas" value="1.300.000" oninput="formatAndCalculate()">
      </div>
    </div>

    <!-- TAB 1: ULAMA KONTEMPORER -->
    <div id="tab-kontemporer" class="tab-content active">
      <div class="info-box">
        <strong>Ketentuan Kontemporer (Fatwa MUI No. 3/2003):</strong><br>
        Zakat dihitung langsung saat menerima penghasilan bersih bulanan. Nisab setara 85 gram emas per tahun (± 7,08 gram/bulan). Kadar zakat 2.5%.
      </div>

      <div class="form-group">
        <label for="gajiBulanan">Penghasilan Bersih per Bulan (Kotor - Kebutuhan Pokok):</label>
        <div class="input-wrapper">
          <span class="currency-prefix">Rp</span>
          <input type="text" id="gajiBulanan" placeholder="0" oninput="formatAndCalculate()">
        </div>
      </div>

      <div class="result-card">
        <div class="result-title">Kewajiban Zakat Profesi (Per Bulan)</div>
        <div class="result-value" id="hasilZakatKontemporer">Rp 0</div>
        <div id="statusKontemporer" class="status-badge status-belum">Belum Wajib Zakat</div>
      </div>
    </div>

    <!-- TAB 2: FIKIH KLASIK -->
    <div id="tab-klasik" class="tab-content">
      <div class="info-box">
        <strong>Ketentuan Madzhab Klasik (Hanafi, Maliki, Syafi'i, Hanbali):</strong><br>
        Tidak ada zakat langsung atas penghasilan. Zakat dihitung dari sisa tabungan/harta yang bertahan mengendap selama 1 tahun (Haul) & mencapai nisab (85 gram emas). Kadar zakat 2.5%.
      </div>

      <div class="form-group">
        <label for="totalTabungan">Total Tabungan / Harta Simpanan (Mengendap 1 Tahun):</label>
        <div class="input-wrapper">
          <span class="currency-prefix">Rp</span>
          <input type="text" id="totalTabungan" placeholder="0" oninput="formatAndCalculate()">
        </div>
      </div>

      <div class="result-card">
        <div class="result-title">Kewajiban Zakat Mal / Tabungan (Per Tahun)</div>
        <div class="result-value" id="hasilZakatKlasik">Rp 0</div>
        <div id="statusKlasik" class="status-badge status-belum">Belum Wajib Zakat</div>
      </div>
    </div>
  </div>

  <script>
    let activeTab = 'kontemporer';

    // Pindah Tab
    function switchTab(tabName) {
      activeTab = tabName;
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

      if (tabName === 'kontemporer') {
        document.querySelectorAll('.tab-btn')[0].classList.add('active');
        document.getElementById('tab-kontemporer').classList.add('active');
      } else {
        document.querySelectorAll('.tab-btn')[1].classList.add('active');
        document.getElementById('tab-klasik').classList.add('active');
      }
      formatAndCalculate();
    }

    // Mengubah String Berformat Ribuan ke Angka murni
    function parseNumber(value) {
      if (!value) return 0;
      return parseFloat(value.replace(/\./g, '')) || 0;
    }

    // Mengubah Angka Murni ke Format Ribuan dengan Titik (id-ID)
    function formatNumber(num) {
      return num.toLocaleString('id-ID');
    }

    // Menangani Input Real-time: Formatting & Perhitungan
    function formatAndCalculate() {
      // 1. Format Input Emas
      const emasInput = document.getElementById('hargaEmas');
      let emasVal = parseNumber(emasInput.value);
      emasInput.value = formatNumber(emasVal);

      if (activeTab === 'kontemporer') {
        // 2. Format & Hitung Kontemporer
        const gajiInput = document.getElementById('gajiBulanan');
        let gajiVal = parseNumber(gajiInput.value);
        gajiInput.value = formatNumber(gajiVal);

        const nisabTahun = 85 * emasVal;
        const nisabBulan = nisabTahun / 12;

        const hasilElement = document.getElementById('hasilZakatKontemporer');
        const statusElement = document.getElementById('statusKontemporer');

        if (gajiVal >= nisabBulan && nisabBulan > 0) {
          const zakat = gajiVal * 0.025;
          hasilElement.innerText = 'Rp ' + formatNumber(zakat);
          statusElement.innerText = 'Wajib Zakat (Nisab Bulanan: Rp ' + formatNumber(Math.round(nisabBulan)) + ')';
          statusElement.className = 'status-badge status-wajib';
        } else {
          hasilElement.innerText = 'Rp 0';
          statusElement.innerText = 'Belum Mencapai Nisab Bulanan (Rp ' + formatNumber(Math.round(nisabBulan)) + ')';
          statusElement.className = 'status-badge status-belum';
        }

      } else {
        // 3. Format & Hitung Klasik
        const tabunganInput = document.getElementById('totalTabungan');
        let tabunganVal = parseNumber(tabunganInput.value);
        tabunganInput.value = formatNumber(tabunganVal);

        const nisabTahun = 85 * emasVal;

        const hasilElement = document.getElementById('hasilZakatKlasik');
        const statusElement = document.getElementById('statusKlasik');

        if (tabunganVal >= nisabTahun && nisabTahun > 0) {
          const zakat = tabunganVal * 0.025;
          hasilElement.innerText = 'Rp ' + formatNumber(zakat);
          statusElement.innerText = 'Wajib Zakat (Nisab Tahunan: Rp ' + formatNumber(nisabTahun) + ')';
          statusElement.className = 'status-badge status-wajib';
        } else {
          hasilElement.innerText = 'Rp 0';
          statusElement.innerText = 'Belum Mencapai Nisab Tahunan (Rp ' + formatNumber(nisabTahun) + ')';
          statusElement.className = 'status-badge status-belum';
        }
      }
    }

    // Inisialisasi awal saat halaman dimuat
    document.addEventListener('DOMContentLoaded', () => {
      formatAndCalculate();
    });
  </script>
</body>
</html>
